{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'serverless functions only — no build step'",
  "outputDirectory": "public",
  "functions": {
    "api/cron/daily.ts": { "maxDuration": 300 },
    "api/cron/refill.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 8,11,14,16 * * *" },
    { "path": "/api/cron/refill", "schedule": "30 6 * * 1-5" },
    { "path": "/api/cron/report", "schedule": "0 17 * * *" }
  ]
}
